# Docker Compose settings. Copy to .env to override the defaults.
# Application settings for Laravel live in backend/.env (created from backend/.env.example).

# PostgreSQL
POSTGRES_DB=maintenance
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=change-me-in-dev

# Host ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
AGENT_PORT=8001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Seed development users and projects on first start (empty database only).
SEED_ON_START=true

# GitHub App (optional). Organizations can also connect with a personal access token.
# Register the App as described in docs/github.md. Put the .pem under backend/storage/app/private/
# and reference it by its container path, e.g. /var/www/html/storage/app/private/github-app.pem
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_WEBHOOK_SECRET=
# Public URL GitHub can reach for webhooks (e.g. a tunnel such as https://xyz.trycloudflare.com).
# Defaults to the backend's APP_URL, which GitHub cannot reach on localhost.
GITHUB_WEBHOOK_BASE_URL=

# Shared secret for control plane <-> agent calls (used from Phase 3).
# Generate one with: openssl rand -hex 32
AGENT_INTERNAL_TOKEN=
